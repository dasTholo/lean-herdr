{
  // Project configuration for opencode.
  "$schema": "https://opencode.ai/config.json",

  // lean-ctx wrap does not know opencode -- the MCP registration is manual.
  // The command WITHOUT a subcommand is the stdio server; `serve` would be HTTP.
  "mcp": {
    "lean-ctx": {
      "type": "local",
      "command": ["lean-ctx"],
      "enabled": true
    }
  },

  "agent": {
    "orchestrator": {
      "description": "Hands tasks to worker agents. Writes no code itself.",
      "mode": "primary",
      "prompt": "{file:./roles/orchestrator.md}",
      // The only candidate for a cost cap: max_cost_usd in the lean-ctx role
      // counts no money, but a tool-I/O estimate (B5).
      "steps": 60,
      // Here -- and only here -- enforcement bites. The lean-ctx role is a
      // context shaper, not a guard: [tools] allowed/denied is not enforced
      // (B4).
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": {
          "*": "deny",
          "bin/herdr-dispatch *": "allow",
          "herdr *": "allow",
          "wt *": "allow",
          "git status*": "allow",
          "git log*": "allow"
        }
      }
    },
    // The worker's order path is a CLI now, so both workers need a shell
    // permission they never had -- granted per subcommand, because
    // "bin/herdr-report *" would let through anything behind the program name.
    "builder": {
      "description": "Writes code against one work order at a time.",
      "mode": "primary",
      "prompt": "{file:./roles/builder.md}",
      "steps": 60,
      "permission": {
        // roles/builder.md prescribes TDD and commits through
        // `wt step commit --stage none`. With the report patterns alone the
        // builder could run neither a test nor a commit and would fail on
        // its first step -- so exactly the gate that role text demands is
        // granted, and nothing wider. No `git push`, no bare `git *`, no
        // wildcard behind `bin/herdr-report`, and one worktrunk subcommand
        // rather than `wt *`, which would carry merge and push with it.
        "bash": {
          "*": "deny",
          "bin/herdr-report next": "allow",
          "bin/herdr-report show *": "allow",
          "bin/herdr-report start *": "allow",
          "bin/herdr-report done *": "allow",
          "bin/herdr-report fail *": "allow",
          "bin/herdr-report ask *": "allow",
          "uv run pytest*": "allow",
          "uv run ruff*": "allow",
          "git add*": "allow",
          "git commit*": "allow",
          "git diff*": "allow",
          "git status*": "allow",
          "wt step commit *": "allow"
        }
      }
    },
    "reviewer": {
      "description": "Reviews the builder's work. Answers with a verdict of result or reject.",
      "mode": "primary",
      "prompt": "{file:./roles/reviewer.md}",
      "steps": 40,
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": {
          "*": "deny",
          "bin/herdr-report next": "allow",
          "bin/herdr-report show *": "allow",
          "bin/herdr-report start *": "allow",
          "bin/herdr-report done *": "allow",
          "bin/herdr-report fail *": "allow",
          "bin/herdr-report ask *": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git status*": "allow"
        }
      }
    }
  }
}
