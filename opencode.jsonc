{
  // Project configuration for opencode.
  "$schema": "https://opencode.ai/config.json",

  // lean-ctx wrap does not know opencode -- the MCP registration is manual.
  // The command WITHOUT a subcommand is the stdio server; `serve` would be HTTP.
  "mcp": {
    "lean-ctx": {
      "type": "local",
      "command": ["lean-ctx"],
      "enabled": true
    }
  },

  "agent": {
    "orchestrator": {
      "description": "Hands tasks to worker agents. Writes no code itself.",
      "mode": "primary",
      "prompt": "{file:./roles/orchestrator.md}",
      // The only candidate for a cost cap: max_cost_usd in the lean-ctx role
      // counts no money, but a tool-I/O estimate (B5).
      "steps": 60,
      // Here -- and only here -- enforcement bites. The lean-ctx role is a
      // context shaper, not a guard: [tools] allowed/denied is not enforced
      // (B4).
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": {
          "*": "deny",
          "bin/herdr-dispatch *": "allow",
          "herdr *": "allow",
          "wt *": "allow",
          "git status*": "allow",
          "git log*": "allow"
        }
      }
    },
    "reviewer": {
      "description": "Reviews the builder's work. Answers with a verdict of result or reject.",
      "mode": "primary",
      "prompt": "{file:./roles/reviewer.md}",
      "steps": 40,
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git status*": "allow"
        }
      }
    }
  }
}
